    "staff:provision": "node --env-file-if-exists=.env.local --import tsx scripts/provision-staff.ts",
    "verify:booking-pilot": "node scripts/verify-booking-pilot.mjs",
    "verify:pilot": "node scripts/verify-pilot.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "verify:studio-ai": "node scripts/verify-studio-ai.mjs",
    "verify:operations": "node scripts/verify-operations.mjs",
    "verify:completion": "node scripts/verify-completion.mjs",
    "verify:personal-reserve": "node scripts/verify-personal-reserve.mjs",
    "verify:collection-commerce": "node scripts/verify-collection-commerce.mjs",
    "verify:studio-loading": "node scripts/verify-studio-loading.mjs",
