    "@fontsource/manrope": "^5.3.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "@vercel/functions": "^3.9.11",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0",
