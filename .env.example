# Local synthetic preview only. Never enabled in production.
RESERVE_DEV_PREVIEW=true
APP_ORIGIN=http://localhost:3000
# Hosted setup: use Supabase's server-side Postgres connection.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Apple providers in Supabase Auth. No provider secrets belong here.

# Server-only Aethelios connection. Never use NEXT_PUBLIC for this key.
OPENAI_API_KEY=
RESERVE_AI_MODEL=gpt-4.1-mini

# Future Shopify / POS connection only. Do not rebuild checkout here.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
