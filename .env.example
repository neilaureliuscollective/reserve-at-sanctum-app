# Local synthetic preview only. Never enabled in production.
RESERVE_DEV_PREVIEW=true
APP_ORIGIN=http://localhost:3000
# Hosted setup: use Supabase's server-side Postgres connection.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Apple providers in Supabase Auth. No provider secrets belong here.

# Optional staff coworker activation. Never expose the API key to the browser.
RESERVE_AI_ENABLED=false
OPENAI_API_KEY=
# Use an approved Responses-compatible model configured in your OpenAI project.
RESERVE_AI_MODEL=
# 0 means no daily message ceiling. Short burst protection still applies.
RESERVE_AI_DAILY_ATTEMPTS=0
RESERVE_AI_BUSINESS_DAILY_ATTEMPTS=0
