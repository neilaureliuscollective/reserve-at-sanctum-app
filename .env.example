# Local synthetic preview only. Never enabled in production.
RESERVE_DEV_PREVIEW=true
APP_ORIGIN=http://localhost:3000
# Hosted setup: use Supabase's server-side Postgres connection.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Apple providers in Supabase Auth. No provider secrets belong here.

# Server-only Aethelios connection. Never use NEXT_PUBLIC for this key.
OPENAI_API_KEY=
RESERVE_AI_MODEL=gpt-4.1-mini

# Server-only Square connection. Never use NEXT_PUBLIC for these values.
# The application builds and runs without them; commerce and webhooks stay disabled.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_API_VERSION=2026-09-16
# Seller Square Appointments privileges are not assumed. Leave false until verified.
SQUARE_BOOKINGS_ENABLED=false

# Optional MEMBER concierge conversation, distinct from the existing staff assistant.
# Verified member tools work without paid AI. Leave the model empty to disable it.
# Before enabling, supply current provider token prices for this exact model.
RESERVE_CONCIERGE_MODEL=
RESERVE_CONCIERGE_INPUT_USD_PER_MILLION=
RESERVE_CONCIERGE_OUTPUT_USD_PER_MILLION=
# Per-member and overall monthly ceilings in cents. Server reservations enforce both.
RESERVE_CONCIERGE_MEMBER_MONTHLY_CENTS=200
RESERVE_CONCIERGE_TENANT_MONTHLY_CENTS=2500

# Optional Shopify Collection bridge. No settings are changed automatically.
# Keep provider empty to retain the existing dormant/read-only Square adapter.
RESERVE_COMMERCE_PROVIDER=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_COLLECTION_HANDLE=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CHECKOUT_ENABLED=false
# Exact comma-separated HTTPS hosts permitted for Shopify's returned checkout URL.
# The configured myshopify.com store hostname is included automatically.
SHOPIFY_CHECKOUT_HOSTS=
