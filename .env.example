# Local synthetic preview only. Never enabled in production.
RESERVE_DEV_PREVIEW=true
APP_ORIGIN=http://localhost:3000
# Hosted setup: use Supabase's server-side Postgres connection.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Apple providers in Supabase Auth. No provider secrets belong here.
# Hosted preview deployments MUST use an isolated database and this explicit marker.
RESERVE_DATABASE_ENV=preview
# Transactional email and external scheduler (server-only).
RESEND_API_KEY=
RESERVE_EMAIL_FROM=
RESERVE_CRON_SECRET=
# Phase 2 merchant configuration: server-only, test credentials for isolated staging.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Explicit production-only live-payment gate; default is disabled.
RESERVE_LIVE_COMMERCE=false
