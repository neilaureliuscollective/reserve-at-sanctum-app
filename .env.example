# Local synthetic preview only. Never enabled in production.
RESERVE_DEV_PREVIEW=true
APP_ORIGIN=http://localhost:3000
# Hosted setup: Gent Ascend Supabase project, ref volpzkfsnmtztrovexcw.
# DATABASE_URL must use the reserve_app role and the transaction pooler URL
# copied from Supabase Connect. Never put the database password in Git.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ADMIN_DATABASE_URL is for staff:provision only, never a Vercel runtime variable.
# ADMIN_DATABASE_URL=
# Existing deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Apple providers in Supabase Auth. No provider secrets belong here.
