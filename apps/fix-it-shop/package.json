{
  "name": "fix-it-shop",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:app": "node ../../scripts/prepare-fix-it-app.mjs",
    "build": "npm run prepare:app && next build",
